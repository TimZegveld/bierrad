{
  "display_information": {
    "name": "Bierrad",
    "description": "Samen draaien, samen bier halen.",
    "background_color": "#7a4e10"
  },
  "features": {
    "bot_user": {
      "display_name": "Bierrad",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/bierrad",
        "url": "https://bierrad-live.timzegveld.workers.dev/slack/bier-commands",
        "description": "Start een bierronde (standaard vandaag om 15.45)",
        "usage_hint": "[dag] [tijd] [aantal] [eigen tekst]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://bierrad-live.timzegveld.workers.dev/auth/slack/callback"
    ],
    "scopes": {
      "user": [
        "openid"
      ],
      "bot": [
        "reactions:read",
        "reactions:write",
        "users:read",
        "chat:write",
        "commands"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
