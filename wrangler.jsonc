{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bierrad-live",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://timzegveld.github.io",
    "FRONTEND_URL": "https://timzegveld.github.io/bierrad/",
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "LiveSession" },
      { "name": "CHANNELS", "class_name": "ChannelWheel" },
      { "name": "RATINGS", "class_name": "Ratings" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveSession"] },
    { "tag": "v2", "new_sqlite_classes": ["ChannelWheel"] },
    { "tag": "v3", "new_sqlite_classes": ["Ratings"] },
  ],
  "ratelimits": [
    {
      "name": "CREATION_LIMIT",
      "namespace_id": "84653101",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "CREATION_GLOBAL",
      "namespace_id": "84653102",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "84653103",
      "simple": { "limit": 240, "period": 60 },
    },
  ],
  "env": {
    "development": {
      "vars": {
        "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173",
        "FRONTEND_URL": "http://127.0.0.1:5173/",
      },
      "durable_objects": {
        "bindings": [
          { "name": "SESSIONS", "class_name": "LiveSession" },
          { "name": "CHANNELS", "class_name": "ChannelWheel" },
          { "name": "RATINGS", "class_name": "Ratings" },
        ],
      },
      "ratelimits": [
        {
          "name": "CREATION_LIMIT",
          "namespace_id": "84653201",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "CREATION_GLOBAL",
          "namespace_id": "84653202",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "REQUEST_LIMIT",
          "namespace_id": "84653203",
          "simple": { "limit": 240, "period": 60 },
        },
      ],
    },
  },
}
